# Copy to ai-service/.env

# MANDATORY - Google Gemini API key.
# Read implicitly by ChatGoogleGenerativeAI in llm/gemini.py (model: gemini-2.5-flash).
GOOGLE_API_KEY=your-google-gemini-api-key

# MANDATORY - SerpAPI key.
# Used by tools/hotel_search.py and tools/flight_search.py for live hotel and
# flight results. Without it those calls return 401 and planning fails.
SERPAPI_KEY=your-serpapi-key

# OPTIONAL - browsers never call this service directly (the backend does),
# so this only matters if you expose it to a browser. Defaults to
# http://localhost:3000,http://localhost:5000
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# OPTIONAL - only read by run.py. Defaults: PORT=8000, RELOAD=false
PORT=8000
RELOAD=true
