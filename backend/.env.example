# .env.example 

# Copy to backend/.env for local development.
# Read via `spring.config.import=optional:file:.env[.properties]`, so the file
# is resolved relative to the working directory - run the app from backend/.
# In production, supply these as real environment variables instead.

# --- MANDATORY -------------------------------------------------------------

# MongoDB connection string. The database name is the path segment
# (".../voyagent" below). Collections `users` and `trips` are created on demand.
MONGO_DB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/voyagent?retryWrites=true&w=majority

# HS256 signing key for auth cookies. MUST be at least 32 characters or the
# app refuses to start. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# --- OPTIONAL (safe local defaults shown) ----------------------------------

# HTTP port. Default: 5000 (the frontend expects this).
server.port=5000

# "production" switches auth cookies to Secure + SameSite=None.
# Anything else (default "development") uses SameSite=Lax without Secure.
NODE_ENV=development

# Token and cookie lifetime. Default: 7d
# JWT_EXPIRATION=7d

# Base URL of the FastAPI AI service. Default: http://localhost:8000
AI_SERVICE_URL=http://localhost:8000

# Extra allowed CORS origins, comma-separated. Blanks are ignored.
# http://localhost:3000 and http://127.0.0.1:3000 are ALWAYS allowed.
# FRONTEND_URL, CLIENT_URL and CORS_ORIGIN are merged together.
FRONTEND_URL=http://localhost:3000
# CLIENT_URL=
# CORS_ORIGIN=
